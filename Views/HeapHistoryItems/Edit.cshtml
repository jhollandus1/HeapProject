@model HeapProject.Models.HeapHistoryItemViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Encrypted item</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="SavedTimeString" class="control-label fw-bold"></label>
                <span asp-display-for="SavedTimeString" class="form-label"></span>
                <span asp-validation-for="SavedTimeString" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EncryptedItemLabel" class="control-label fw-bold"></label>
                <input asp-for="EncryptedItemLabel" class="form-control" />
                <span asp-validation-for="EncryptedItemLabel" class="text-danger"></span>
            </div>
            <div>
                <span asp-display-for="EncryptedItem"></span>
            </div>
            <div class="form-group">
                <input type="submit" id="submitFormId" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
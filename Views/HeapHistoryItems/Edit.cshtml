    function AddItemToHeap() {
        const keyValue = document.getElementById('keyValue').value;
        const valueValue = document.getElementById('valuePayload').value;
        AddItemToHeapImpl(keyValue, valueValue, USER_INPUT);
    }

    function AddItemToHeapImpl(keyValue, valueValue, mode) {
        let keyValueAsInt = Number.parseInt(keyValue);

        if (!Number.isInteger(keyValueAsInt) || keyValueAsInt < 1) {
            alert("key must be an integer greater than or equal to 1");
            return;
        }
        if (!heapGlobalMap.has(keyValueAsInt) && heapGlobalMap.size() + 1 <= 15) {
            heapGlobalMap.set(keyValueAsInt, valueValue);
            arrayHeap.Add(keyValueAsInt, valueValue, mode); 
            localStorage.setItem("lastAddedKey" + keyValueAsInt, new Date().toLocaleString() + " " + keyValueAsInt + " " + valueValue);
            //localStorage.setItem(getIterationValue)
        }
        else if (heapGlobalMap.size() === MaxNumberViewableElements) {
            alert("Size limit reached for graphical display of max heap");
        }
        else {
            alert("Duplicates not allowed in this max heap.");
            return;
        }
    }

    function GetSum() {
        let visitor = new SumVisitor();
        let size = arrayHeap.Size();
        for (let i = 0; i < size; i++) {
            let node = arrayHeap.GetNodeAtIndex(i);
            node.Accept(visitor);
        }
        alert("The sum of the nodes is: " + visitor.GetSum());
    }

    function RemoveMax() {
        // remove the key from the hashtable and save it
        // take the last node in the heap and put it in topmost position
        // sift down

        // display the node that was removed in an alert box when the animation completes - or maybe in a new "results" box
        let removedElement = null;
        if (heapGlobalMap.size() > 0) {
            removedElement = arrayHeap.RemoveMax();
            heapGlobalMap.remove(removedElement.key);
            localStorage.setItem("lastRemovedKey" + removedElement.key, new Date().toLocaleString() + " " + removedElement.key);
            //alert(removedElement.key);
        }
        else {
            alert("No more elements in the max heap.")
        }
    }

    async function BulkLoad(mode, arrayToReconstitute = null) {
        disableUI();

        let bulkLoadArray1 = [[89, "89value"],
        [77, "77value"], [88, "88value"],
        [11, "11value"], [16, "16value"], [7, "7value"], [15, "15value"],
        [6, "6value"], [9, "9value"], [8, "8value"], [13, "13value"], [3, "3value"], [4, "4value"], [12, "12value"], [14, "14value"]];

        let bulkLoadArray2 = [[3, "3value"],
        [4, "4value"], [6, "6value"],
        [7, "7value"], [8, "8value"], [9, "9value"], [11, "11value"],
        [12, "12value"], [13, "13value"], [14, "14value"], [15, "15value"], [16, "16value"], [77, "77value"], [88, "88value"], [89, "89value"]];

        let bulkLoadArray3 = [[89, "89value"],
        [77, "77value"], [88, "88value"],
        [11, "11value"], [16, "16value"], [15, "15value"], [7, "7value"],
        [6, "6value"], [9, "9value"], [8, "8value"], [13, "13value"], [12, "12value"], [14, "14value"], [3, "3value"], [4, "4value"]];

        let bulkLoadArray4 = [[89, "89value"],
        [77, "77value"], [88, "88value"],
        [11, "11value"], [16, "16value"], [7, "7value"], [15, "15value"]];

        let current = bulkLoadArray2;
        if(arrayToReconstitute !== null)
        {
            current = arrayToReconstitute;
        }

        if (document.getElementById('maxVar' + lastMaxNode) !== null) {
            document.getElementById('maxVar' + lastMaxNode).remove();
        }

        const slider = document.querySelector('input[type="range"]');
        slider.value = MINIMUM_VALUE_DURATION;
        durationOfAnimation = MINIMUM_VALUE_DURATION;
        const syntheticEvent1 = new Event('input', { bubbles: true });
        slider.dispatchEvent(syntheticEvent1);
        // so since the heap is in the right order, no switches, so 100ms is close enough to instantaneous (not rewriting)
        for (let i = 0; i < current.length; i++) {
            AddItemToHeapImpl(current[i][0], current[i][1], mode);
            await delay(GetMode(mode, BULK_LOAD_METHOD)); //2000);  // we will have slightly more than 500 ms of animation time at minimum * 3, so need to wait 2s total, else two visual bugs (13 and 11 switched, one missing) with only 1000ms
        }   // this is a problem for restoring it

        const syntheticEvent2 = new Event('input', { bubbles: true });
        slider.value = MIDPOINT_VALUE_DURATION;
        durationOfAnimation = MIDPOINT_VALUE_DURATION;
        slider.dispatchEvent(syntheticEvent2);

        reenableUI();
    }

    function disableUI() {
        document.getElementById("addKeyValue").disabled = true;
        document.getElementById("getSum").disabled = true;
        document.getElementById("removeMax").disabled = true;
        document.getElementById("addBulk").disabled = true;
        document.getElementById("submitFormId").disabled = true;
    }

    function reenableUI() {
        document.getElementById("addKeyValue").disabled = false;
        document.getElementById("getSum").disabled = false;
        document.getElementById("removeMax").disabled = false;
        document.getElementById("addBulk").disabled = false;
        document.getElementById("submitFormId").disabled = false;
    }

    function generateLimitedHeapToSave(heap) {
        let limitedHeap = {};
        limitedHeap.heapArray = heap.GetShallowHeapCopy();  // order of nodes is implicit
        limitedHeap.stackOfTxtNodes = heap.stackOfTxtNodes;
        limitedHeap.count = heap.count;

        return limitedHeap;
    }

    function AppendHeapToSave() {
        let limitedHeapToSave = generateLimitedHeapToSave(arrayHeap);
        let data = JSON.stringify(limitedHeapToSave);
        document.getElementById("HeapItem").value = data;
    }


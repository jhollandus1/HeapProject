    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="SavedTime" class="control-label"></label>
                <input asp-for="SavedTime" class="form-control" disabled="disabled" />
                <span asp-validation-for="SavedTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HeapItemLabel" class="control-label"></label>
                <input asp-for="HeapItemLabel" class="form-control" />
                <span asp-validation-for="HeapItemLabel" class="text-danger"></span>
            </div>
            <div>
                <input type="hidden" asp-for="HeapItem"/>
            </div>
            <div class="form-group">
                <input type="submit" id="submitFormId" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <div>
        <br />
        <br />
        <button id="addKeyValue">Add node</button>
        <input type="text" id="keyValue" value="Enter Key" />
        <input type="text" id="valuePayload" value="Payload">
        <br />
        <button id="getSum">Get sum of key values</button>
        <br />
        <button id="removeMax">Remove Max</button>
        <br />
        Animation speed: <input type="range" id="animationDurationId" min="0.01" max="2.0" step="0.1"/>
        <br />
        <br />
        <button id="addBulk">Add bulk array</button>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}